{
    "name": "slate",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "nuxt build && wrangler dev",
        "deploy": "nuxt build && wrangler deploy",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "MIGRATE_TARGET=prod drizzle-kit migrate"
    },
    "dependencies": {
        "@neon/config": "^1.14.6",
        "@neon/env": "^2.1.9",
        "@neondatabase/serverless": "1.2.1",
        "better-auth": "1.7.27",
        "drizzle-orm": "0.45.4",
        "nuxt": "4.6.4",
        "sanitize-html": "2.18.2"
    },
    "devDependencies": {
        "@types/sanitize-html": "^2.16.2",
        "dotenv": "^18.0.10",
        "drizzle-kit": "0.31.11",
        "typescript": "5.9.3",
        "vue-tsc": "^3.3.14",
        "wrangler": "4.167.0"
    }
}
