{
    "name": "slate",
    "private": true,
    "type": "module",
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "preview": "nuxt build && wrangler dev",
        "deploy": "nuxt build && wrangler deploy",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "MIGRATE_TARGET=prod drizzle-kit migrate",
        "stripe:setup": "node --env-file=.env --experimental-strip-types --no-warnings scripts/stripe-setup.ts",
        "test": "vitest run",
        "test:api": "vitest run --config vitest.api.config.ts",
        "dev:test": "NUXT_TURNSTILE_SECRET=1x0000000000000000000000000000000AA NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA nuxt dev --port 3001",
        "og:images": "tsx scripts/share-images.ts",
        "demos:record": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/record-demos.ts"
    },
    "dependencies": {
        "@neon/config": "^1.14.6",
        "@neon/env": "^2.1.9",
        "@neondatabase/serverless": "1.2.1",
        "better-auth": "1.7.27",
        "drizzle-orm": "0.45.4",
        "fflate": "0.8.2",
        "nuxt": "4.6.4",
        "sanitize-html": "2.18.2",
        "uqr": "0.1.3"
    },
    "devDependencies": {
        "@types/sanitize-html": "^2.16.2",
        "dotenv": "^18.0.10",
        "drizzle-kit": "0.31.11",
        "ffmpeg-static": "^5.3.0",
        "playwright-core": "^1.65.1",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "3.2.4",
        "vue-tsc": "^3.3.14",
        "wrangler": "4.167.0"
    },
    "resolutions": {
        "@types/node": "26.6.6"
    }
}
