# Supabase project (used by @nuxtjs/supabase — see layers/cms-core/nuxt.config.ts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Server-only. Used by supabase/migrations tooling, and by exactly one
# runtime path: server/utils/supabaseServiceRole.ts, called only from
# server/api/admin/signup-requests/[id]/convert.post.ts to invite a
# brand-new user (Supabase Auth user creation has no RLS-scoped
# equivalent). Never expose this to the client and never reference it
# from any other Nitro API route — those must use the request-scoped,
# RLS-enforced client (see layers/cms-core/server/utils/requireSiteAccess.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Lets Settings' "Custom domain" field register a customer's
# domain against this Vercel project automatically (see
# server/utils/vercelDomains.ts) instead of someone doing it by hand in
# the Vercel dashboard for every new site. Get a token from
# vercel.com/account/tokens (scope it to the right Team if the project
# isn't under your personal account) and the project ID from the
# project's Settings -> General tab. VERCEL_TEAM_ID is only needed if the
# project lives under a Team.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=

# Optional. Once you own a domain and have wildcard DNS + a wildcard TLS
# cert pointed at this app (see README.md "Wildcard subdomains per
# site"), every site automatically gets {slug}.{this domain} for free,
# the same way {slug}.localhost already works with no setup at all.
# Leave unset until that DNS/cert work is actually done. Public (not a
# secret) — it's a domain name, needed client-side too so the site
# dashboard can build the live-site link without a server round trip.
NUXT_PUBLIC_BASE_DOMAIN=
