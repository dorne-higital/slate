# Neon → your project → Connection details → "Pooled connection" string
NUXT_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Any long random string. Generate one with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=

# Local development hosts. In production: slatecms.co.uk / slatecms.co.uk
NUXT_PUBLIC_APP_HOST=localhost:3000
NUXT_PUBLIC_SITES_DOMAIN=localhost:3000
